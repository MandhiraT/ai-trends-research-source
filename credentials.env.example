# AI Trends Research — Credentials Template
# Copy to credentials.env and fill in your values

# Required: Gemini API for summarization
GEMINI_API_KEY=your_gemini_api_key_here

# Required: GitHub token for pushing reports
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub config for report uploads
GITHUB_REPO=MandhiraT/ai-trends-research
GIT_USER_EMAIL=your@email.com
GIT_USER_NAME=YourGitHubUsername

# Optional: path overrides
# PROJECT_ROOT=/custom/path/to/ai-trends-research-source
# GITHUB_TEMP_CLONE=/tmp/ai-trends-research
