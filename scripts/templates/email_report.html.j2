<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ topic_name }} — ATS Report</title>
  <style>
    body { margin: 0; padding: 20px; background: #f4f6f9; font-family: Arial, sans-serif; color: #1a202c; }
    .wrapper { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header { background: #111827; color: #fff; padding: 20px 28px; }
    .header h1 { margin: 0; font-size: 20px; font-weight: 700; }
    .header p { margin: 5px 0 0; font-size: 13px; color: #9ca3af; }
    .summary { padding: 22px 28px; border-bottom: 1px solid #e5e7eb; }
    .badge { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 13px; border-radius: 999px; padding: 4px 14px; margin-bottom: 14px; font-weight: 600; }
    .headings { margin: 0; padding-left: 22px; color: #374151; }
    .headings li { margin: 0 0 8px; line-height: 1.5; }
    .headings li:last-child { margin-bottom: 0; }
    .heading-level-1 { font-weight: 700; color: #111827; }
    .heading-level-2 { font-weight: 600; color: #1f2937; }
    .heading-level-3, .heading-level-4, .heading-level-5, .heading-level-6 { color: #4b5563; font-size: 13px; }
    .links { padding: 20px 28px; border-bottom: 1px solid #e5e7eb; }
    .links h2 { margin: 0 0 14px; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: .06em; }
    .btn { display: inline-block; text-decoration: none; padding: 9px 18px; border-radius: 6px; font-size: 14px; margin-right: 8px; margin-bottom: 8px; }
    .btn-primary { background: #0d63ce; color: #fff; }
    .btn-secondary { background: #f3f4f6; color: #374151; border: 1px solid #e5e7eb; }
    .footer { padding: 16px 28px; text-align: center; font-size: 12px; color: #9ca3af; background: #f9fafb; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>{{ topic_name }}</h1>
      <p>ATS Research &nbsp;·&nbsp; {{ date_thai }}{% if run_label %} &nbsp;·&nbsp; {{ run_label }}{% endif %}</p>
    </div>
    <div class="summary">
      <div class="badge">{{ video_count }} วิดีโอใหม่</div>
      {% if report_headings %}
      <ul class="headings">
        {% for heading in report_headings %}
        <li class="heading-level-{{ heading.level }}">{{ heading.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="links">
      <h2>ดาวน์โหลด / อ่าน</h2>
      {% if view_url %}
      <a class="btn btn-primary" href="{{ view_url }}">👁 View Report (browser)</a>
      <br>
      {% endif %}
      <a class="btn btn-secondary" href="{{ md_download_url }}">📄 Download Report (.md)</a>
      {% if wav_download_url %}
      <br>
      <a class="btn btn-primary" href="{{ wav_download_url }}">🎧 Listen to Audio (all videos)</a>
      {% endif %}
    </div>
    <div class="footer">
      AI Trends Research System
    </div>
  </div>
</body>
</html>
